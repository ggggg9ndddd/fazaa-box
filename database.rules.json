{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.val() === true"
      }
    },
    "devices": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "contactWhatsapp": {
        ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{8}$/))"
      },
      "rules": {
        "openSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 120"
        },
        "pinMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
        },
        "graceMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
        },
        "returnOnlyAfterDue": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "toolCodes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$toolId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('state').child('activeByTool').child($toolId).exists() && (root.child('rentals').child(root.child('users').child(auth.uid).child('state').child('activeByTool').child($toolId).val()).child('status').val() === 'paid' || root.child('rentals').child(root.child('users').child(auth.uid).child('state').child('activeByTool').child($toolId).val()).child('status').val() === 'active')",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,8}$/)"
      }
    },
    "box": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)"
    },
    "tools": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$toolId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'compartment', 'status', 'plans', 'lateFeePerHour'])",
        "status": {
          ".validate": "newData.val() === 'available' || newData.val() === 'reserved' || newData.val() === 'rented' || newData.val() === 'maintenance'"
        },
        "compartment": {
          ".validate": "newData.isNumber()"
        },
        "lateFeePerHour": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
        "profile": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name', 'universityId', 'phone', 'email', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
          },
          "universityId": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,12}$/)"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
          "activeRental": {
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.isString() && !root.child('rentals').child(newData.val()).exists() && newData.parent().parent().parent().parent().child('rentals').child(newData.val()).child('uid').val() === auth.uid && newData.parent().parent().parent().parent().child('rentals').child(newData.val()).child('status').val() === 'pending') || (data.exists() && !newData.exists() && root.child('rentals').child(data.val()).child('status').val() === 'pending' && newData.parent().parent().parent().parent().child('rentals').child(data.val()).child('status').val() === 'cancelled'))",
            ".validate": "newData.isString()"
          },
          "activeByTool": {
            "$toolId": {
              ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.isString() && !root.child('rentals').child(newData.val()).exists() && newData.parent().parent().parent().parent().parent().child('rentals').child(newData.val()).child('uid').val() === auth.uid && newData.parent().parent().parent().parent().parent().child('rentals').child(newData.val()).child('status').val() === 'pending' && newData.parent().parent().parent().parent().parent().child('rentals').child(newData.val()).child('toolId').val() === $toolId) || (data.exists() && !newData.exists() && root.child('rentals').child(data.val()).child('status').val() === 'pending' && newData.parent().parent().parent().parent().parent().child('rentals').child(data.val()).child('status').val() === 'cancelled'))",
              ".validate": "newData.isString()"
            }
          },
          "lateFeeDue": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "blocked": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rentals": {
      ".indexOn": [
        "uid",
        "status"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      "$rid": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('createdAt').val() === now && root.child('users').child(auth.uid).child('profile').exists() && root.child('users').child(auth.uid).child('state').child('blocked').val() !== true && !root.child('users').child(auth.uid).child('state').child('activeByTool').child(newData.child('toolId').val()).exists() && (!root.child('users').child(auth.uid).child('state').child('lateFeeDue').exists() || root.child('users').child(auth.uid).child('state').child('lateFeeDue').val() === 0) && root.child('tools').child(newData.child('toolId').val()).child('status').val() === 'available' && newData.child('toolName').val() === root.child('tools').child(newData.child('toolId').val()).child('name').val() && newData.child('compartment').val() === root.child('tools').child(newData.child('toolId').val()).child('compartment').val() && newData.child('hours').val() === root.child('tools').child(newData.child('toolId').val()).child('plans').child(newData.child('plan').val()).child('hours').val() && newData.child('amount').val() === root.child('tools').child(newData.child('toolId').val()).child('plans').child(newData.child('plan').val()).child('amount').val() && newData.parent().parent().child('users').child(auth.uid).child('state').child('activeByTool').child(newData.child('toolId').val()).val() === $rid && !newData.hasChild('paidAt') && !newData.hasChild('startAt') && !newData.hasChild('dueAt') && !newData.hasChild('returnedAt') && !newData.hasChild('lateFee') && !newData.hasChild('currentPin') && !newData.hasChild('paymentClaimedAt')))",
        ".validate": "newData.hasChildren(['uid', 'toolId', 'toolName', 'compartment', 'plan', 'hours', 'amount', 'ref', 'status', 'createdAt'])",
        "uid": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
        },
        "toolId": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
        },
        "toolName": {
          ".validate": "newData.isString()"
        },
        "compartment": {
          ".validate": "newData.isNumber()"
        },
        "plan": {
          ".validate": "newData.isString()"
        },
        "hours": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ref": {
          ".validate": "newData.isString() && newData.val().matches(/^FZ-[A-Z0-9]{6}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.val() === 'pending' && newData.val() === 'cancelled'",
          ".validate": "newData.val() === 'pending' || newData.val() === 'paid' || newData.val() === 'active' || newData.val() === 'returning' || newData.val() === 'returned' || newData.val() === 'cancelled' || newData.val() === 'rejected'"
        },
        "paymentClaimedAt": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.parent().child('status').val() === 'pending' && newData.val() === now",
          ".validate": "newData.isNumber()"
        },
        "paidAt": {
          ".validate": "newData.isNumber()"
        },
        "approvedBy": {
          ".validate": "newData.isString()"
        },
        "startAt": {
          ".validate": "newData.isNumber()"
        },
        "dueAt": {
          ".validate": "newData.isNumber()"
        },
        "extendedBy": {
          ".validate": "newData.isString()"
        },
        "returnedAt": {
          ".validate": "newData.isNumber()"
        },
        "lateFee": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "hiddenByUser": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid && newData.val() === true && (data.parent().child('status').val() === 'returned' || data.parent().child('status').val() === 'cancelled' || data.parent().child('status').val() === 'rejected')",
          ".validate": "newData.isBoolean()"
        },
        "lateFeePaid": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devices').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}